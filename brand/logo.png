<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 80" fill="none">
  <defs>
    <linearGradient id="gear" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#94A3B8"/>
      <stop offset="100%" stop-color="#64748B"/>
    </linearGradient>
  </defs>

  <!-- Gear -->
  <g transform="translate(38,40)">
    <circle cx="0" cy="0" r="14" fill="none" stroke="url(#gear)" stroke-width="5"/>
    <circle cx="0" cy="0" r="6" fill="url(#gear)"/>
    <g stroke="url(#gear)" stroke-width="4" stroke-linecap="round">
      <line x1="0" y1="-22" x2="0" y2="-16"/>
      <line x1="0" y1="16" x2="0" y2="22"/>
      <line x1="-22" y1="0" x2="-16" y2="0"/>
      <line x1="16" y1="0" x2="22" y2="0"/>
      <line x1="-15.5" y1="-15.5" x2="-11" y2="-11"/>
      <line x1="11" y1="11" x2="15.5" y2="15.5"/>
      <line x1="15.5" y1="-15.5" x2="11" y2="-11"/>
      <line x1="-11" y1="11" x2="-15.5" y2="15.5"/>
    </g>
  </g>

  <!-- CHAMO -->
  <text x="68" y="36" font-family="Poppins, Arial, sans-serif" font-size="30" font-weight="800" fill="#1D3557" stroke="white" stroke-width="2" paint-order="stroke">CHAMO</text>

  <!-- IMPORT -->
  <text x="68" y="58" font-family="Poppins, Arial, sans-serif" font-size="30" font-weight="800" fill="#1D3557" stroke="white" stroke-width="2" paint-order="stroke">IMPORT</text>

  <!-- S.R.L. -->
  <text x="68" y="73" font-family="Inter, Arial, sans-serif" font-size="11" font-weight="600" fill="#475569" letter-spacing="2">S.R.L.</text>
</svg>
